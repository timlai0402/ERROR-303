{
  "name": "error-303",
  "version": "1.0.0",
  "description": "StockWise - Simple, reliable inventory tracker for independent small hardware shops and auto-mechanics",
  "main": "frontend-bridge.js",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npx serve -l 3000 .",
    "backend": "backend\\.venv\\Scripts\\python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "test": "backend\\.venv\\Scripts\\python -m pytest backend/tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timlai0402/ERROR-303.git"
  },
  "keywords": [],
