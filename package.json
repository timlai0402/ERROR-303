  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/timlai0402/ERROR-303/issues"
  },
  "homepage": "https://github.com/timlai0402/ERROR-303#readme",
  "dependencies": {
    "@supabase/server": "^1.9.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
